FROM python:3.12-slim

# Same base, env and torch layer as vision/Containerfile, so the build cache shares that layer
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/hf \
    TORCH_HOME=/cache/torch

WORKDIR /srv

# torch in its own layer so changing requirements.txt doesn't re-download it
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==2.5.1 torchvision==0.20.1

# ffmpeg builds the proxy, feeds the detectors and extracts audio for transcription
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server.py detectors.py transnetv2.py transcribe.py ./

# /videos is shared with the web app, which writes the uploads (both run as uid 1001)
RUN useradd --system --uid 1001 --create-home app \
 && mkdir -p /cache /videos && chown app /cache /videos
ENV VIDEO_CACHE=/cache VIDEO_DIR=/videos
USER app

EXPOSE 8001
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]
